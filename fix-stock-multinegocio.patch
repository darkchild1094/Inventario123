From 31f05837d21e43c84f4d43d24c9b757c12089827 Mon Sep 17 00:00:00 2001
From: Darkchilld <raul@darkchilld.dev>
Date: Wed, 29 Jul 2026 06:57:58 +0000
Subject: [PATCH] Fix: soporte multi-negocio para stock personal (asignado/en
 uso)

Causa raiz: la tabla stock no distinguia negocio/plaza para el stock
personal de cada usuario (tipo='usuario'), una sola fila global por
usuario_id. El sistema inferia el negocio de un activo asignado a un
usuario desde usuario.plaza_id (fijo), por lo que SIEMPRE se mostraba
bajo el negocio de la plaza principal del usuario sin importar que
unidad de negocio se hubiera elegido al registrar el activo.

- Stock::obtenerPorUsuario()/crearParaUsuario() ahora aceptan plaza_id,
  permitiendo que un mismo usuario tenga un stock personal separado por
  cada plaza/negocio en el que opera.
- HomeController::guardar() ahora pasa la plaza/negocio seleccionado en
  el formulario en los 4 puntos donde se resuelve el stock personal
  (fs, ati, admin/coordinador asignando a otro usuario, stock_destino
  manual).
- Activo::obtenerTodosFiltrado()/obtenerPorId() priorizan stock.plaza_id
  sobre usuario.plaza_id al resolver la plaza/negocio mostrado.
- ApiController::obtenerStockPorUsuario acepta plaza_id opcional.

Requiere migracion SQL (ver migracion_stock_plaza_id.sql): agrega
columna plaza_id a stock, con backfill para no romper datos existentes.
---
 app/controllers/ApiController.php  |  5 ++--
 app/controllers/HomeController.php | 14 +++++------
 app/models/Activo.php              |  4 ++--
 app/models/Stock.php               | 37 ++++++++++++++++++++++--------
 4 files changed, 40 insertions(+), 20 deletions(-)

diff --git a/app/controllers/ApiController.php b/app/controllers/ApiController.php
index 2e699a0..df42f11 100644
--- a/app/controllers/ApiController.php
+++ b/app/controllers/ApiController.php
@@ -138,11 +138,12 @@ class ApiController
         $this->json((new Usuario($this->db))->obtenerPorPlaza((int) $_GET['plaza_id']));
     }
 
-    // GET ?action=obtenerStockPorUsuario&usuario_id=X
+    // GET ?action=obtenerStockPorUsuario&usuario_id=X&plaza_id=Y
     public function obtenerStockPorUsuario(): void
     {
         if (empty($_GET['usuario_id'])) { $this->json(null); return; }
-        $this->json((new Stock($this->db))->obtenerPorUsuario((int) $_GET['usuario_id']));
+        $plazaId = (int) ($_GET['plaza_id'] ?? 0);
+        $this->json((new Stock($this->db))->obtenerPorUsuario((int) $_GET['usuario_id'], $plazaId));
     }
 
     // GET ?action=obtenerStockPorBodega&bodega_id=X
