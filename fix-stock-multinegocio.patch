@@ -267,9 +267,9 @@ class HomeController
             $datos['stock_id'] = $stock ? $stock['id'] : null;
 
         } elseif ($tipo === 'ati') {
-            // ati: asignado/en_uso → stock personal | en_bodega/garantia/baja → bodega de la plaza seleccionada
+            // ati: asignado/en_uso → stock personal (scopeado a la plaza/negocio elegido) | en_bodega/garantia/baja → bodega de la plaza seleccionada
             if ($statusPost === 'en_uso' || $statusPost === 'asignado') {
-                $stock = $stockModel->obtenerPorUsuario(Permisos::idUsuario());
+                $stock = $stockModel->obtenerPorUsuario(Permisos::idUsuario(), $plazaId);
             } else {
                 $bodega = (new Bodega($this->db))->obtenerPorPlaza($plazaId);
                 $stock  = $bodega ? $stockModel->obtenerPorBodega((int)$bodega['id']) : null;
@@ -289,8 +289,8 @@ class HomeController
                     $this->redirigir('index.php?action=crear&plaza_id=' . $plazaId);
                 }
             }
-            // Asignado a usuario específico
-            $stock = $stockModel->obtenerPorUsuario($asignadoUsuarioId);
+            // Asignado a usuario específico (stock scopeado a la plaza/negocio elegido)
+            $stock = $stockModel->obtenerPorUsuario($asignadoUsuarioId, $plazaId);
             $datos['stock_id'] = $stock ? $stock['id'] : null;
 
         } elseif (!empty($stockDestino)) {
@@ -315,7 +315,7 @@ class HomeController
                     $stock = $stockModel->obtenerPorBodega((int)$id_dest);
                 }
             } else {
-                $stock = $stockModel->obtenerPorUsuario((int)$id_dest);
+                $stock = $stockModel->obtenerPorUsuario((int)$id_dest, $plazaId);
             }
             $datos['stock_id'] = $stock ? $stock['id'] : null;
 
