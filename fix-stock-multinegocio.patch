diff --git a/app/models/Stock.php b/app/models/Stock.php
index 12710a3..50ee555 100644
--- a/app/models/Stock.php
+++ b/app/models/Stock.php
@@ -32,20 +32,36 @@ class Stock
     }
 
     /**
-     * Obtiene el stock de un usuario. Si no existe, lo crea automáticamente.
+     * Obtiene el stock PERSONAL de un usuario, SCOPEADO a una plaza específica.
+     * Un mismo usuario puede tener varios stocks personales, uno por cada
+     * plaza/negocio en el que opera (ej. uno para OXXO-Valles, otro para
+     * BARA-León). Si no existe para esa plaza, lo crea automáticamente.
+     *
+     * Si $plazaId se omite (0), cae al comportamiento legado: usa la plaza
+     * principal del usuario (usuario.plaza_id). Esto es solo para no romper
+     * llamadas antiguas; en código nuevo SIEMPRE se debe pasar la plaza
+     * seleccionada en el formulario.
      */
-    public function obtenerPorUsuario(int $usuarioId): array|false
+    public function obtenerPorUsuario(int $usuarioId, int $plazaId = 0): array|false
     {
+        if ($plazaId <= 0) {
+            $stmtUsr = $this->conn->prepare('SELECT plaza_id FROM usuario WHERE id = :id LIMIT 1');
+            $stmtUsr->bindValue(':id', $usuarioId, PDO::PARAM_INT);
+            $stmtUsr->execute();
+            $plazaId = (int) ($stmtUsr->fetchColumn() ?: 0);
+        }
+
         $stmt = $this->conn->prepare(
             "SELECT * FROM {$this->table}
-             WHERE tipo = 'usuario' AND usuario_id = :id LIMIT 1"
+             WHERE tipo = 'usuario' AND usuario_id = :uid AND plaza_id = :pid LIMIT 1"
         );
-        $stmt->bindValue(':id', $usuarioId, PDO::PARAM_INT);
+        $stmt->bindValue(':uid', $usuarioId, PDO::PARAM_INT);
+        $stmt->bindValue(':pid', $plazaId, PDO::PARAM_INT);
         $stmt->execute();
         $row = $stmt->fetch(PDO::FETCH_ASSOC);
 
         if (!$row) {
-            $this->crearParaUsuario($usuarioId);
+            $this->crearParaUsuario($usuarioId, $plazaId);
             $stmt->execute();
             $row = $stmt->fetch(PDO::FETCH_ASSOC);
         }
@@ -75,14 +91,17 @@ class Stock
         return $row;
     }
 
-    public function crearParaUsuario(int $usuarioId): bool
+    public function crearParaUsuario(int $usuarioId, int $plazaId = 0): bool
     {
         try {
             $stmt = $this->conn->prepare(
-                "INSERT INTO {$this->table} (tipo, usuario_id, bodega_id)
-                 VALUES ('usuario', :usuario_id, NULL)"
+                "INSERT INTO {$this->table} (tipo, usuario_id, bodega_id, plaza_id)
+                 VALUES ('usuario', :usuario_id, NULL, :plaza_id)"
             );
-            return $stmt->execute([':usuario_id' => $usuarioId]);
+            return $stmt->execute([
+                ':usuario_id' => $usuarioId,
+                ':plaza_id'   => $plazaId > 0 ? $plazaId : null,
+            ]);
         } catch (PDOException $e) {
             throw $e;
         }
